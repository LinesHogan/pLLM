class PageCapacity(RuntimeError):
    """Native slot exhaustion translated to admission backpressure by the execution boundary."""

class SlotLedger:
    """Numeric field-page holds and reuse fences, owned by one thread."""
    def __init__(self, width: int, capacity: int) -> None: ...
    def free_count(self, field: int) -> int: ...
    def allocate(
        self, field: int, count: int, completed: _Int64Array
    ) -> tuple[_Int64Array, _Int64Array, _Int64Array, _Int64Array]: ...
    def hold(self, slots: _Int64Array) -> None: ...
    def release(self, slots: _Int64Array, completion: int, completed: _Int64Array) -> _Int64Array: ...
    def check(self, slots: _Int64Array, generations: _Int64Array) -> None: ...
    def check_page(self, field: int, slot: int, generation: int) -> None: ...

_RefColumns = tuple[_Int64Array, _Int64Array, _Int64Array, _Int64Array | None]
PageCopy = tuple[int, int, _Int64Array, _Int64Array]
PagePrepared = tuple[int, _Int64Array, list[PageCopy], _Int64Array, _Int64Array]
PageSnapshot = tuple[int, _Int64Array, _Int64Array, _Int64Array, _Int64Array, npt.NDArray[np.bool_] | None]

