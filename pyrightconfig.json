{
  "typeCheckingMode": "basic",
  "include": ["tllm"],
  "exclude": [
    "tllm/runtime/vllm_patch",
    "tllm/backends",
    "tllm/contracts",
    "tllm/ports",
    "tllm/producers",
    "tllm/core",
    "tllm/workgraph",
    "**/__pycache__"
  ],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11"
}
