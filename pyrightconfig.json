{
  "typeCheckingMode": "basic",
  "include": ["tllm"],
  "exclude": [
    "tllm/backends",
    "tllm/canonical",
    "tllm/canonical_vllm",
    "tllm/contracts",
    "**/__pycache__"
  ],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11"
}
