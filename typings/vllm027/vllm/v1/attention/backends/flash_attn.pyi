from dataclasses import dataclass
import torch

@dataclass
class FlashAttentionMetadata:
    num_actual_tokens: int
    max_query_len: int
    query_start_loc: torch.Tensor
    max_seq_len: int
    seq_lens: torch.Tensor
    block_table: torch.Tensor
    slot_mapping: torch.Tensor
    use_cascade: bool
    common_prefix_len: int
    cu_prefix_query_lens: torch.Tensor | None
    prefix_kv_lens: torch.Tensor | None
    suffix_kv_lens: torch.Tensor | None
    max_dcp_context_kv_len: int | None = ...
    dcp_context_kv_lens: torch.Tensor | None = ...
    num_decode_reqs: int = ...
    num_prefill_reqs: int = ...
    num_decode_tokens: int = ...
    num_prefill_tokens: int = ...
    scheduler_metadata: torch.Tensor | None = ...
    prefix_scheduler_metadata: torch.Tensor | None = ...
    max_num_splits: int = ...
    causal: bool | torch.Tensor = ...
    sliding_window: tuple[int, int] | None = ...
    mm_prefix_range_tensor: torch.Tensor | None = ...
    rswa_prefix_lens: torch.Tensor | None = ...
    rswa_window: int | None = ...
    rswa_window_tensor: torch.Tensor | None = ...

class FlashAttentionImpl:
    vllm_flash_attn_version: int | None
