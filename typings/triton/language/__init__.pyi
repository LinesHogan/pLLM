"""The device DSL subset used by the maintained grouped kernel.

constexpr arguments are integer/bool compile-time values at the host call site.
Torch Tensor kernel parameters become device pointers, not eager tensor values.
"""

from collections.abc import Iterable
from typing import TypeAlias, overload

import torch

constexpr: TypeAlias = int

class dtype: ...

float32: dtype
float64: dtype
int32: dtype
int64: dtype
uint32: dtype
uint64: dtype

class tensor:
    shape: tuple[int, ...]
    def to(self, dtype: dtype, bitcast: bool = False) -> tensor: ...
    def __add__(self, other: tensor | torch.Tensor | int | float) -> tensor: ...
    def __radd__(self, other: tensor | torch.Tensor | int) -> tensor: ...
    def __sub__(self, other: tensor | int) -> tensor: ...
    def __rsub__(self, other: int | float) -> tensor: ...
    def __neg__(self) -> tensor: ...
    def __truediv__(self, other: tensor | float) -> tensor: ...
    def __floordiv__(self, other: tensor | int) -> tensor: ...
    def __mod__(self, other: tensor | int) -> tensor: ...
    def __rtruediv__(self, other: float) -> tensor: ...
    def __mul__(self, other: tensor | int | float) -> tensor: ...
    def __rmul__(self, other: tensor | int | float) -> tensor: ...
    def __lt__(self, other: tensor | int) -> tensor: ...
    def __gt__(self, other: tensor | int) -> tensor: ...
    def __ge__(self, other: tensor | int) -> tensor: ...
    def __le__(self, other: tensor | int) -> tensor: ...
    def __and__(self, other: tensor | int) -> tensor: ...
    def __or__(self, other: tensor | int) -> tensor: ...
    def __xor__(self, other: tensor | int) -> tensor: ...
    def __invert__(self) -> tensor: ...
    def __eq__(self, other: object) -> tensor: ...
    def __ne__(self, other: object) -> tensor: ...
    def __lshift__(self, other: tensor | int) -> tensor: ...
    def __rshift__(self, other: tensor | int) -> tensor: ...
    def __getitem__(self, key: tuple[slice | None, ...]) -> tensor: ...

def program_id(axis: int) -> tensor: ...
def num_programs(axis: int) -> tensor: ...
def arange(start: int, end: int) -> tensor: ...
def zeros(shape: tuple[int, ...], dtype: dtype) -> tensor: ...
@overload
def cdiv(x: int, y: int) -> int: ...
@overload
def cdiv(x: tensor, y: int) -> tensor: ...
def range(start: tensor | int, end: tensor | int | None = None, step: tensor | int = 1) -> Iterable[tensor]: ...
def static_range(start: int, end: int | None = None, step: int = 1) -> Iterable[int]: ...
def load(pointer: tensor | torch.Tensor, mask: tensor | None = None, other: int | float = 0) -> tensor: ...
def store(pointer: tensor | torch.Tensor, value: tensor, mask: tensor | None = None) -> None: ...
def dot(input: tensor, other: tensor, acc: tensor, *, input_precision: str) -> tensor: ...
def fma(x: tensor, y: tensor, z: tensor) -> tensor: ...
def sum(input: tensor, axis: int) -> tensor: ...
def sqrt(input: tensor) -> tensor: ...
def div_rn(x: tensor | float, y: tensor | float) -> tensor: ...
def where(condition: tensor | bool, x: tensor | int | float, y: tensor | int | float) -> tensor: ...
def cast(input: tensor | float, dtype: dtype) -> tensor: ...
def cumsum(input: tensor, axis: int) -> tensor: ...
def gather(input: tensor, indices: tensor, axis: int) -> tensor: ...
def maximum(input: tensor, other: tensor | int) -> tensor: ...
def minimum(input: tensor, other: tensor | int) -> tensor: ...
def full(shape: tuple[int, ...], value: float | int, dtype: dtype) -> tensor: ...
def min(input: tensor, axis: int) -> tensor: ...
def max(input: tensor, axis: int) -> tensor: ...
def debug_barrier() -> None: ...
def log(value: tensor) -> tensor: ...
def exp(value: tensor) -> tensor: ...
