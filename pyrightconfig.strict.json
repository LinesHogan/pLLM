{
  "typeCheckingMode": "strict",
  "include": [
    "tllm/contracts",
    "tllm/canonical",
    "tllm/canonical_vllm",
    "tllm/backends/protocol.py",
    "tllm/backends/vllm/dense_parameter_overlay.py",
    "tllm/backends/vllm/_step_session.py",
    "tllm/backends/vllm/runner_adapter.py",
    "tllm/backends/vllm/typed_layer_replay.py",
    "tllm/backends/vllm/versioned_parameter_overlay.py",
    "tllm/backends/vllm/overlay_state.py",
    "test/gpu/canonical_vllm_esamp_smoke.py",
    "test/gpu/canonical_fttt_cuda_smoke.py"
  ],
  "exclude": ["**/__pycache__"],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "stubPath": "typings/vllm027",
  "reportUnnecessaryIsInstance": "error",
  "reportUnnecessaryComparison": "error",
  "reportUnnecessaryCast": "error",
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11"
}
