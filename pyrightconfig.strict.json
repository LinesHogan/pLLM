{
  "typeCheckingMode": "strict",
  "include": [
    "tllm/contracts",
    "tllm/ports",
    "tllm/producers",
    "tllm/core",
    "tllm/workgraph"
  ],
  "exclude": ["**/__pycache__"],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11"
}
