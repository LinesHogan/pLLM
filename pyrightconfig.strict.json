{
  "typeCheckingMode": "strict",
  "include": [
    "tllm/contracts",
    "tllm/ports",
    "tllm/producers",
    "tllm/core",
    "tllm/workgraph",
    "tllm/workload",
    "tllm/kit/backend.py",
    "tllm/kit/workload.py",
    "tllm/runtime/runtime.py",
    "tllm/runtime/backend_region_binders.py",
    "tllm/runtime/declaration_adapter.py",
    "tllm/runtime/mp/worker_extension.py",
    "tllm/runtime/workload_execution.py",
    "tllm/runtime/workload_plugins.py",
    "tllm/runtime/workload_bindings.py",
    "tllm/runtime/workload_sinks.py",
    "tllm/consumers/dummy/workload.py",
    "tllm/consumers/esamp/workload.py",
    "tllm/consumers/override/workload.py",
    "tllm/consumers/reft/workload.py",
    "tllm/consumers/ttrl/workload.py",
    "tllm/consumers/recirculation/workload.py",
    "tllm/consumers/recirculation/native_backend.py",
    "tllm/consumers/recirculation/stage_definition.py",
    "tllm/consumers/recirculation/stage_binding.py",
    "test/typing/native_workload_api.py"
  ],
  "exclude": ["**/__pycache__"],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "reportUnnecessaryIsInstance": "error",
  "reportUnnecessaryComparison": "error",
  "reportUnnecessaryCast": "error",
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11"
}
